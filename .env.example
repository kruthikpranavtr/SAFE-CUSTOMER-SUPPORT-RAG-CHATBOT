# =================================================================
# SAFE CUSTOMER SUPPORT RAG CHATBOT - ENVIRONMENT CONFIGURATION
# =================================================================

# Server & Project Settings
PROJECT_NAME="Safe Customer Support RAG Chatbot"
API_V1_STR="/api"

# Storage & Database Locations
DATABASE_PATH="./data/app.db"
VECTOR_DB_PATH="./data/vectorstore"
DOCUMENTS_DIR="./data/documents"

# LLM Provider Configuration
# Supported providers: "local", "gemini", "openai"
# When "local" is selected, the application operates in 100% offline mode with
# grounded extractive synthesis and uncertainty calibration, requiring no API keys.
LLM_PROVIDER="local"

# External API Keys (Optional - only required if LLM_PROVIDER is "gemini" or "openai")
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# Retrieval & Safety Thresholds
TOP_K_CHUNKS=4
SIMILARITY_THRESHOLD_HIGH=0.60
SIMILARITY_THRESHOLD_MODERATE=0.40
SIMILARITY_THRESHOLD_LOW=0.20
